<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="measurementType"><xs:restriction base="xs:string"><xs:enumeration value="fixed"/><xs:enumeration value="area"/><xs:enumeration value="linear"/><xs:enumeration value="none"/><xs:enumeration value="unknown"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="pricingUnit"><xs:restriction base="xs:string"><xs:enumeration value="unit"/><xs:enumeration value="lot"/><xs:enumeration value="m2"/><xs:enumeration value="cm2"/><xs:enumeration value="linear_meter"/><xs:enumeration value="unknown"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="quantityType"><xs:restriction base="xs:string"><xs:enumeration value="unit"/><xs:enumeration value="exact"/><xs:enumeration value="range"/><xs:enumeration value="free"/><xs:enumeration value="unknown"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="priceBasis"><xs:restriction base="xs:string"><xs:enumeration value="unit"/><xs:enumeration value="lot"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="validationStatus"><xs:restriction base="xs:string"><xs:enumeration value="ok"/><xs:enumeration value="review"/><xs:enumeration value="reject"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="dimensionUnit"><xs:restriction base="xs:string"><xs:enumeration value="mm"/><xs:enumeration value="cm"/><xs:enumeration value="m"/></xs:restriction></xs:simpleType>
  <xs:element name="supplierCatalog">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="catalogDate" type="xs:date" minOccurs="0"/>
        <xs:element name="items">
          <xs:complexType><xs:sequence>
            <xs:element name="item" maxOccurs="unbounded">
              <xs:complexType><xs:sequence>
                <xs:element name="sku" type="xs:string"/>
                <xs:element name="name" type="xs:string" minOccurs="0"/>
                <xs:element name="description" type="xs:string" minOccurs="0"/>
                <xs:element name="category" type="xs:string" minOccurs="0"/>
                <xs:element name="printMode" type="xs:string" minOccurs="0"/>
                <xs:element name="weight" type="xs:decimal" minOccurs="0"/>
                <xs:element name="baseQuantity" type="xs:decimal" minOccurs="0"/>
                <xs:element name="minimumOrderQuantity" type="xs:decimal" minOccurs="0"/>
                <xs:element name="leadTimeDays" type="xs:nonNegativeInteger" minOccurs="0"/>
                <xs:element name="sourceSize" type="xs:string" minOccurs="0"/>
                <xs:element name="width" type="xs:decimal" minOccurs="0"/>
                <xs:element name="height" type="xs:decimal" minOccurs="0"/>
                <xs:element name="depth" type="xs:decimal" minOccurs="0"/>
                <xs:element name="dimensionUnit" type="dimensionUnit" minOccurs="0"/>
                <xs:element name="sourcePrice" type="xs:string" minOccurs="0"/>
                <xs:element name="purchasePrice" type="xs:decimal"/>
                <xs:element name="measurementType" type="measurementType" minOccurs="0"/>
                <xs:element name="pricingUnit" type="pricingUnit" minOccurs="0"/>
                <xs:element name="quantityType" type="quantityType" minOccurs="0"/>
                <xs:element name="priceBasis" type="priceBasis" minOccurs="0"/>
                <xs:element name="minQuantity" type="xs:nonNegativeInteger" minOccurs="0"/>
                <xs:element name="maxQuantity" type="xs:nonNegativeInteger" minOccurs="0"/>
                <xs:element name="minWidth" type="xs:decimal" minOccurs="0"/>
                <xs:element name="maxWidth" type="xs:decimal" minOccurs="0"/>
                <xs:element name="minHeight" type="xs:decimal" minOccurs="0"/>
                <xs:element name="maxHeight" type="xs:decimal" minOccurs="0"/>
                <xs:element name="minArea" type="xs:decimal" minOccurs="0"/>
                <xs:element name="maxArea" type="xs:decimal" minOccurs="0"/>
                <xs:element name="parentKey" type="xs:string" minOccurs="0"/>
                <xs:element name="validationStatus" type="validationStatus"/>
                <xs:element name="validationNotes" type="xs:string" minOccurs="0"/>
                <xs:element name="attributes" minOccurs="0"><xs:complexType><xs:sequence>
                  <xs:element name="attribute" minOccurs="0" maxOccurs="unbounded"><xs:complexType mixed="true"><xs:attribute name="name" type="xs:string" use="required"/></xs:complexType></xs:element>
                </xs:sequence></xs:complexType></xs:element>
              </xs:sequence></xs:complexType>
            </xs:element>
          </xs:sequence></xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" use="required" fixed="2.1"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
