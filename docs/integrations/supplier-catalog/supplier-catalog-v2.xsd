<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="supplierCatalog">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="catalogDate" type="xs:date" minOccurs="0"/>
        <xs:element name="items">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="item" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="sku" type="xs:string"/>
                    <xs:element name="name" type="xs:string" minOccurs="0"/>
                    <xs:element name="description" type="xs:string" minOccurs="0"/>
                    <xs:element name="category" type="xs:string" minOccurs="0"/>
                    <xs:element name="printMode" type="xs:string" minOccurs="0"/>
                    <xs:element name="weight" type="xs:decimal" minOccurs="0"/>
                    <xs:element name="minimumOrderQuantity" type="xs:decimal" minOccurs="0"/>
                    <xs:element name="leadTimeDays" type="xs:nonNegativeInteger" minOccurs="0"/>
                    <xs:element name="sourceSize" type="xs:string" minOccurs="0"/>
                    <xs:element name="width" type="xs:decimal" minOccurs="0"/>
                    <xs:element name="height" type="xs:decimal" minOccurs="0"/>
                    <xs:element name="depth" type="xs:decimal" minOccurs="0"/>
                    <xs:element name="dimensionUnit" minOccurs="0">
                      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="mm"/><xs:enumeration value="cm"/><xs:enumeration value="m"/></xs:restriction></xs:simpleType>
                    </xs:element>
                    <xs:element name="sourcePrice" type="xs:string" minOccurs="0"/>
                    <xs:element name="purchasePrice" type="xs:decimal"/>
                    <xs:element name="measurementType" minOccurs="0">
                      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="fixed"/><xs:enumeration value="area"/><xs:enumeration value="linear"/><xs:enumeration value="none"/><xs:enumeration value="unknown"/></xs:restriction></xs:simpleType>
                    </xs:element>
                    <xs:element name="pricingUnit" minOccurs="0">
                      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="unit"/><xs:enumeration value="lot"/><xs:enumeration value="m2"/><xs:enumeration value="cm2"/><xs:enumeration value="linear_meter"/><xs:enumeration value="unknown"/></xs:restriction></xs:simpleType>
                    </xs:element>
                    <xs:element name="quantityType" minOccurs="0">
                      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="unit"/><xs:enumeration value="tier"/><xs:enumeration value="free"/><xs:enumeration value="unknown"/></xs:restriction></xs:simpleType>
                    </xs:element>
                    <xs:element name="parentKey" type="xs:string" minOccurs="0"/>
                    <xs:element name="validationStatus" minOccurs="0">
                      <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="ok"/><xs:enumeration value="review"/><xs:enumeration value="reject"/></xs:restriction></xs:simpleType>
                    </xs:element>
                    <xs:element name="validationNotes" type="xs:string" minOccurs="0"/>
                    <xs:element name="attributes" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element name="attribute" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType mixed="true"><xs:attribute name="name" type="xs:string" use="required"/></xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="version" use="required" fixed="2.0"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
